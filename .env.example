# MogulForge GrowthOS — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# Values marked REQUIRED must be set before the server will function correctly.

# ─── Core ─────────────────────────────────────────────────────────────────────

# REQUIRED — PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/mogulforge

# REQUIRED — 32+ character random string for signing session cookies
# Generate one with: openssl rand -base64 32
SESSION_SECRET=replace-me-with-32-plus-random-chars

# REQUIRED — Platform admin password for /admin console
ADMIN_PASSWORD=replace-me-with-strong-password

# REQUIRED — Bearer token for cron/scheduler endpoints
# Generate one with: openssl rand -hex 32
CRON_SECRET=replace-me-with-cron-bearer-token

# ─── AI ───────────────────────────────────────────────────────────────────────

# REQUIRED — OpenAI API key (server-side only, never reaches the browser)
OPENAI_API_KEY=sk-...

# Optional — Override the OpenAI model (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# ─── Email (Transactional) ────────────────────────────────────────────────────

# REQUIRED for email features — Resend API key for platform transactional emails
# (admin alerts, lead digests, onboarding, CRM/calendar notifications)
# Get one at: https://resend.com
RESEND_API_KEY=re_...

# Optional — Resend webhook signing secret (for bounce/complaint handling)
# RESEND_WEBHOOK_SECRET=whsec_...

# Email addresses for lead digest notifications
LEAD_DIGEST_TO=you@yourcompany.com
LEAD_DIGEST_FROM=digest@yourcompany.com
LEAD_DIGEST_REPLY_TO=you@yourcompany.com

# Sender address for per-org alert emails (CRM outage, domain break, calendar issues)
ORG_ALERTS_FROM=alerts@yourcompany.com

# ─── Email (Campaign Outreach) ────────────────────────────────────────────────
# IMPORTANT: This MUST be a different Resend key from RESEND_API_KEY.
# Campaign outreach and platform alerts must never share a key.

# OUTREACH_RESEND_API_KEY=re_...
# OUTREACH_EMAIL_FROM=campaigns@yourclientdomain.com

# ─── SMS (Twilio) ─────────────────────────────────────────────────────────────

# Required for SMS campaigns
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_MESSAGING_SERVICE_SID=MG...
# TWILIO_PHONE_NUMBER=+1...

# ─── Billing (Stripe) ─────────────────────────────────────────────────────────

# Set to "stripe" to enable Stripe billing, or leave unset to disable
# BILLING_PROVIDER=stripe

# ─── URLs ─────────────────────────────────────────────────────────────────────

# Canonical public URL — used in OG tags, email links, and the scan widget
# NEXT_PUBLIC_SITE_URL=https://mogulforge.com

# Server-side base URL for constructing absolute links in emails
# PUBLIC_BASE_URL=https://mogulforge.com

# ─── Custom Domains ───────────────────────────────────────────────────────────

# The CNAME target clients point their custom domain at
# e.g. clients set: portal.theirbusiness.com CNAME portals.mogulforge.com
# CUSTOM_DOMAIN_CNAME_TARGET=portals.mogulforge.com

# ─── Public API ───────────────────────────────────────────────────────────────

# Static bearer token for the Revenue Rescue public API
# RR_API_KEY=...

# Requests-per-minute for the public API (default: 60)
# PUBLIC_API_RATE_LIMIT=60
